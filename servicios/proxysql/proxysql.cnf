datadir="/var/lib/proxysql"

admin_variables=
{
    admin_credentials="admin:admin;radmin:radmin"
    mysql_ifaces="0.0.0.0:6032"
}

mysql_variables=
{
    threads=4
    max_connections=2048
    default_query_delay=0
    default_query_timeout=36000000
    have_compress=true
    poll_timeout=2000
    interfaces="0.0.0.0:3306"
    default_schema="information_schema"
    stacksize=1048576
    server_version="5.7.99"
    connect_timeout_server=3000
    monitor_history=60000
    monitor_connect_interval=60000
    monitor_ping_interval=10000
    monitor_read_only_interval=1500
    monitor_read_only_timeout=500
    ping_interval_server=120000
    monitor_username="monitor"    
    monitor_password="monitor"    
    ping_timeout_server=500
    commands_stats=true
    sessions_sort=true
    connect_retries_on_failure=10
}

mysql_servers =
(
    { address="db_master", port=3306, hostgroup=10, max_connections=100, comment="master" },
    { address="db_slave1", port=3306, hostgroup=20, max_connections=100, comment="slave1" },
    { address="db_slave2", port=3306, hostgroup=20, max_connections=100, comment="slave2" }
)

mysql_users =
(
    { username="suitecrm_user", password="secret", default_hostgroup=10, transaction_persistent=1, active=1 }
)

mysql_query_rules =
(
    {
        rule_id=1
        active=1
        match_pattern="^SELECT .* FOR UPDATE$"
        destination_hostgroup=10
        apply=1
    },
    {
        rule_id=2
        active=1
        match_pattern="^SELECT .*"
        destination_hostgroup=20
        apply=1
    },
    {
        rule_id=3
        active=1
        match_pattern="^INSERT|^UPDATE|^DELETE|^CREATE|^DROP|^ALTER"
        destination_hostgroup=10
        apply=1
    }
)
