datadir="/var/lib/proxysql"

admin_variables =
{
    admin_credentials="admin:admin;radmin:radmin"
    mysql_ifaces="0.0.0.0:6032"
    web_enabled=true
    restapi_enabled=false
    admin_password="admin"
}

mysql_variables =
{
    interfaces="0.0.0.0:3306"
    default_schema="information_schema"
    monitor_username="monitor"
    monitor_password="monitor"
    monitor_connect_interval=60000
    monitor_ping_interval=10000
    monitor_read_only_interval=1500
    monitor_read_only_timeout=500
    ping_interval_server=120000
    ping_timeout_server=500
    connect_retries_on_failure=10
    connect_timeout_server=3000
    threads=4
    max_connections=2048
    server_version="10.6.18-MariaDB"   # Adaptado a tu versión de MariaDB
    commands_stats=true
    sessions_sort=true
}

# =============================================
# SERVIDORES (Master + Slaves)
# =============================================
mysql_servers =
(
    { address="db_master", port=3306, hostgroup=10, weight=1000, comment="Master - Writer" },
    { address="db_slave1", port=3306, hostgroup=20, weight=500,  comment="Slave 1 - Reader" },
    { address="db_slave2", port=3306, hostgroup=20, weight=500,  comment="Slave 2 - Reader" }
)

# =============================================
# USUARIOS
# =============================================
mysql_users =
(
    { username="suitecrm_user", password="secret", default_hostgroup=10, transaction_persistent=1, active=1, max_connections=1000 }
)

# =============================================
# REPLICACIÓN (Auto detección Read Only)
# =============================================
mysql_replication_hostgroups =
(
    { writer_hostgroup=10, reader_hostgroup=20, check_type="read_only" }
)

# =============================================
# REGLAS DE READ / WRITE SPLITTING
# =============================================
mysql_query_rules =
(
    # Regla 1: SELECT con FOR UPDATE → Master
    { rule_id=1, active=1, match_pattern="^SELECT .* FOR UPDATE", destination_hostgroup=10, apply=1 },

    # Regla 2: SELECT normales → Slaves
    { rule_id=2, active=1, match_pattern="^SELECT", destination_hostgroup=20, apply=1 },

    # Regla 3: Escrituras → Master
    { rule_id=3, active=1, match_pattern="^(INSERT|UPDATE|DELETE|REPLACE|TRUNCATE|CREATE|DROP|ALTER)", destination_hostgroup=10, apply=1 }
)