#!/bin/bash
set -e

# Si ya existe config.php, aplicar variables de entorno de BD
if [ -f /var/www/html/config.php ]; then
    echo "Aplicando configuración de base de datos..."
    sed -i "s/'db_host_name' => '[^']*'/'db_host_name' => '${DB_HOST:-proxysql}'/g" /var/www/html/config.php
    sed -i "s/'db_port' => '[^']*'/'db_port' => '${DB_PORT:-6033}'/g" /var/www/html/config.php
fi

exec apache2-foreground
